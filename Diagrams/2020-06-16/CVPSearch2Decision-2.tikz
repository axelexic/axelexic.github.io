\input{lattices.tikzset}

\begin{tikzpicture}[x=10, y=10]
    \pgfmathtruncatemacro{\startvalX}{-\pointcountX/2}
    \pgfmathtruncatemacro{\startvalY}{-\pointcountY/2}
    \pgfmathtruncatemacro{\endvalX}{\pointcountX/2}
    \pgfmathtruncatemacro{\endvalY}{\pointcountY/2}
    \pgfmathtruncatemacro{\bOneX}{2*\xstep}
    \pgfmathtruncatemacro{\bOneY}{2*\ystep}
    \pgfmathtruncatemacro{\bTwoX}{2*\xstep}
    \pgfmathtruncatemacro{\bTwoY}{0}

    \coordinate (O) at (\startvalX + \gridstep,%
                        \startvalY + 2*\gridstep);
    \coordinate (b1) at (\bOneX,\bOneY);
    \coordinate (b2) at (\bTwoX,\bTwoY);
    \coordinate (oldB1) at (\xstep,\ystep);
    \coordinate (oldB2) at (2*\xstep,0);
    \coordinate (delta) at (\gridstep,-2*\gridstep);
    \coordinate (gridX) at (\gridstep,0);
    \coordinate (gridY) at (0,\gridstep);

    \begin{scoped}[on background layer]
      \draw[gridstyle] (\startvalX, \startvalY) grid (\endvalX,\endvalY);
    \end{scoped}

    % Old Grid
    \pic[
      latticegrid/sizeX={\pointcountX - \gridstep },
      latticegrid/sizeY={\pointcountY - 2*\gridstep },
      latticegrid/dotpic=inactivedot,
      latticegrid/b1x=\xstep,
      latticegrid/b1y=\ystep,
      latticegrid/b2x={2*\xstep},
      latticegrid/b2y={0}
    ] at ($(O)$) {latticegrid};

    % Old parallelepiped
    \begin{scoped}[on background layer]
      \fill[parallelepiped]
            (O) --
            ($(O) + (oldB1)$) --
            ($(O) + (oldB1) + (oldB2)$) --
            ($(O) + (oldB2)$) --
            cycle;
    \end{scoped}

    % New Grid
    \pic[
      latticegrid/sizeX={\pointcountX - 2*\gridstep },
      latticegrid/sizeY={\pointcountY - 3*\gridstep },
      latticegrid/b1x=\bOneX,
      latticegrid/b1y=\bOneY,
      latticegrid/b2x=\bTwoX,
      latticegrid/b2y=\bTwoY
    ] at (O) {latticegrid};


    % Actual vector diagram
    \path let \p1=(b1),   %
              \p2=(b2),   %
              \p3=(delta) %
          in              %
              pic [
                latticevec/b1text={$2\cdot\vec{b}_1$},
                latticevec/b1textLeftShift={28pt},
                latticevec/b2textRightShift={-10pt},
                latticevec/b1={\x1, \y1}, % b1
                latticevec/b2={\x2, \y2}, % b2
                latticevec/cvp={\x1, \y1},  % cvp is b1
                latticevec/delta={\x3, \y3} % target
              ] (CVPB1) at (O) {latticevec};

    \draw [tgtvec, black, thin] (O) -- ($(O) + (oldB1) + (delta)$);
    \draw [dist] ($(O) + (b1)$) -- ($(O) + (b1) + (delta)$);
    \pic (OldTarget) at ($(O) + (oldB1) + (delta)$) {oldtgt};

    \node[black] at ($(O) + 0.5*(oldB1) + 0.25*(delta)$) {$\vec{t}$};
    \node[black, right] at ($(O) + (b1) + 0.5*(delta) + 0.25*(gridY)$) {$d^\dagger$};

    \node[right, brandColor] at ($(O) + (b1) + 1.25*(delta) + 0.5*(gridY)$) {$\vec{t}^*$};
    \draw[vect] ($(O) + (oldB1) + (delta)$) -- ($(O) + (oldB1) + (delta) + (oldB1)$);

    \node[sectionColor] at ($(O) + 1.5*(oldB1) + (delta) + 0.75*(gridX)$) {$\vec{b}_1$};
\end{tikzpicture}